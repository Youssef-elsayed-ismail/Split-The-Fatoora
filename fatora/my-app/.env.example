# Template only — never put a real key in this file. It is committed on purpose
# (`!.env.example` in .gitignore) so collaborators know which vars to set.
# Copy to `.env`, which is git-ignored, and fill that in instead:
#   cp .env.example .env
# Get a Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6Kx7OHOq4ejFWhQkyacSn-MZU0P0qSyx-lOOTeFh1DdzQ
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash-lite
# Public URL for the browser to reach the API when you expose it via ngrok/Tunnel.
# Example: VITE_API_BASE_URL=https://raking-scoured-cupcake.ngrok-free.dev
VITE_API_BASE_URL=https://raking-scoured-cupcake.ngrok-free.dev
# Port for `npm start` (the production server). Defaults to 5173.
# PORT=5173

# Which OCR provider reads receipt photos. Registered in server/ocr/index.ts.
# Defaults to "claude".
OCR_PROVIDER=gemini
